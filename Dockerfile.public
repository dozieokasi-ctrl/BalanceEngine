FROM python:3.12-slim
WORKDIR /app
COPY requirements-public.txt .
RUN pip install --no-cache-dir -r requirements-public.txt
COPY public_beta.py hosted_calendar.py hosted_dashboard.py hosted_sheets.py assignments_service.py priority_model.py task_scheduler.py free_time_ideas.py ./
COPY recommendation_bank.py ./
COPY templates/public/ ./templates/public/
COPY static/ ./static/
RUN useradd --create-home --uid 10001 beta && mkdir -p /app/data && chown beta:beta /app/data
USER beta
ENV PYTHONUNBUFFERED=1
EXPOSE 8000
CMD ["gunicorn", "--bind", "0.0.0.0:8000", "--workers", "2", "--access-logfile", "-", "public_beta:app"]
