FROM python:3.12-slim
WORKDIR /app
COPY requirements-public.txt .
RUN pip install --no-cache-dir -r requirements-public.txt
COPY public_beta.py hosted_calendar.py priority_model.py ./
COPY templates/public/ ./templates/public/
COPY static/public.css ./static/public.css
RUN useradd --create-home --uid 10001 beta && mkdir -p /app/data && chown beta:beta /app/data
USER beta
ENV PYTHONUNBUFFERED=1
EXPOSE 8000
CMD ["gunicorn", "--bind", "0.0.0.0:8000", "--workers", "2", "--access-logfile", "-", "public_beta:app"]
